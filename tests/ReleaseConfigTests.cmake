string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _id)
set(OUTPUT "${BINARY}/release-config-test-${_id}")
include("${SOURCE}/scripts/Prepare-Release.cmake")
set(_expected ${_files})
foreach(_file IN LISTS _expected)
    if(NOT EXISTS "${OUTPUT}/${_file}")
        message(FATAL_ERROR "Missing release configuration: ${_file}")
    endif()
endforeach()
# A second deployment must retain edits in EVERY managed file, including the manifest.
foreach(_file IN LISTS _expected)
    file(WRITE "${OUTPUT}/${_file}" "user configuration: ${_file}\n")
endforeach()
include("${SOURCE}/scripts/Prepare-Release.cmake")
foreach(_file IN LISTS _expected)
    file(READ "${OUTPUT}/${_file}" _actual)
    if(NOT _actual STREQUAL "user configuration: ${_file}\n")
        message(FATAL_ERROR "Deployment overwrote ${_file}")
    endif()
endforeach()
message(STATUS "Release configuration completeness and edit preservation passed")
